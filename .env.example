# ═══════════════════════════════════════════════════════════════
# KHANG FRONTEND — Environment Variables
# Copy this file to `.env` and fill in your real values.
# ═══════════════════════════════════════════════════════════════

# Backend API URL — points to your Render deployment
# Leave unset (or empty) for offline demo mode

# Local development:
# VITE_API_URL=http://localhost:5000/api

# Production (Render):
VITE_API_URL=https://khang-backend.onrender.com/api
