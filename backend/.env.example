# ═══════════════════════════════════════════════════════════════
# KHANG BACKEND — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env` (for local dev) or paste values into
# Render dashboard → Environment Variables (for production).
# ═══════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Frontend URL (comma-separated if multiple)
# Development: http://localhost:5173
# Production: your Vercel URL, e.g. https://khang.vercel.app
CLIENT_URL=https://khang.vercel.app

# ─── MongoDB (Atlas) ────────────────────────────────────────────
# Get from https://cloud.mongodb.com
# Format: mongodb+srv://user:PASSWORD@cluster.xxxxx.mongodb.net/khang
MONGO_URI=mongodb+srv://khang:PASSWORD@cluster0.xxxxx.mongodb.net/khang?retryWrites=true&w=majority

# ─── JWT Authentication ────────────────────────────────────────
# Any random 32+ character string (Render auto-generates if missing)
JWT_SECRET=change-this-to-a-random-32-character-secret-string-please
JWT_EXPIRES_IN=7d

# ─── Razorpay Payment Gateway ──────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_ (free, no KYC needed)
# Live keys start with rzp_live_ (requires KYC)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# ─── Email Notifications (Gmail + App Password) ────────────────
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-char code below (DO NOT use your Gmail password)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# Restaurant email — receives a copy of every order
RESTAURANT_EMAIL=sultham456@gmail.com
